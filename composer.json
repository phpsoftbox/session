{
    "name": "phpsoftbox/session",
    "description": "Session component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/cookie": "dev-master",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "dev-master",
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpsoftbox/database": "dev-master",
        "phpsoftbox/http-message": "dev-master",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/database": "Required for DatabaseSessionStore."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Session\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Session\\Cli\\SessionCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
